# Discord
DISCORD_BOT_TOKEN=
SFD_DEV_GUILD_ID=
SYNC_GLOBAL_COMMANDS=false
# Local database. For deployment, use postgresql+asyncpg://... from your host.
DATABASE_URL=sqlite+aiosqlite:///./data/sfd_bot.db
# Verification
SFD_VERIFIED_ROLE_ID=
VERIFICATION_EXPIRY_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
# Logging
LOG_LEVEL=INFO
LOG_DIRECTORY=logs